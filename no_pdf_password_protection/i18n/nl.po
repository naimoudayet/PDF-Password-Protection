#. module: no_pdf_password_protection
#: model:ir.model.fields,field_description:no_pdf_password_protection.field_ir_actions_report__x_pdf_password_method
msgid "Password Source"
msgstr "Wachtwoordbron"

#. module: no_pdf_password_protection
#: model_terms:ir.ui.view,arch_db:no_pdf_password_protection.view_ir_actions_report_form_pdf_password
msgid "Printing several records together produces one merged file, which can\n                    carry only one password. When the selected records do not share a password\n                    the merged copy is produced without protection. Print a record on its own,\n                    or use Send &amp; Print, to get a protected copy."
msgstr "Meerdere records samen afdrukken levert één samengevoegd bestand op, dat maar één wachtwoord kan dragen. Delen de gekozen records geen wachtwoord, dan wordt de samengevoegde kopie zonder beveiliging gemaakt. Druk een record afzonderlijk af, of gebruik Verzenden en afdrukken, voor een beveiligde kopie."

#. module: no_pdf_password_protection
#: model:ir.model.fields.selection,name:no_pdf_password_protection.selection__ir_actions_report__x_pdf_encryption_algo__rc4_128
msgid "RC4-128 (legacy readers only)"
msgstr "RC4-128 (alleen oude lezers)"

#. module: no_pdf_password_protection
#: model:ir.model,name:no_pdf_password_protection.model_ir_actions_report
msgid "Report Action"
msgstr "Rapportactie"

#. module: no_pdf_password_protection
#: model:ir.model.fields,field_description:no_pdf_password_protection.field_ir_actions_report__x_pdf_static_password
#: model:ir.model.fields.selection,name:no_pdf_password_protection.selection__ir_actions_report__x_pdf_password_method__static
msgid "Static Password"
msgstr "Statisch wachtwoord"

#. module: no_pdf_password_protection
#: model_terms:ir.ui.view,arch_db:no_pdf_password_protection.view_ir_actions_report_form_pdf_password
msgid "This server only has the older PyPDF2 library, which cannot produce AES.\n                    Documents will be encrypted with RC4-128 whatever is selected above.\n                    Install <b>pypdf</b> on the server to enable AES."
msgstr "Deze server heeft alleen de oudere PyPDF2-bibliotheek, die geen AES kan produceren. Documenten worden met RC4-128 versleuteld, ongeacht de keuze hierboven. Installeer <b>pypdf</b> op de server om AES in te schakelen."

#. module: no_pdf_password_protection
#: model:ir.model.fields,help:no_pdf_password_protection.field_ir_actions_report__x_pdf_aes_unavailable
msgid "True when the installed PDF library cannot produce AES, so encryption silently falls back to RC4-128."
msgstr "Waar wanneer de geïnstalleerde PDF-bibliotheek geen AES kan produceren, waardoor de versleuteling stilzwijgend terugvalt op RC4-128."
