# OCA-derived BLOCKING pylint-odoo rule set — ODOO_GUIDELINES §15.
# Calibrated for pylint-odoo 10.x (Odoo 17-19 series). The pre-commit
# `pylint-odoo` hook runs this; failures block the commit.
#
# Portfolio reconciliations vs OCA defaults (intentional — see §15.1):
#   * manifest-required-authors = Naim OUDAYET  (portfolio author, not OCA)
#   * license-allowed includes OPL-1            (paid modules)
#   * manifest-deprecated-keys is empty         (§4 mandates `description`)
#   * missing-readme NOT enabled                (custom README, not README.rst)
[MASTER]
load-plugins=pylint_odoo
score=n

[ODOOLINT]
manifest-required-authors=Naim OUDAYET
manifest-required-keys=license
manifest-deprecated-keys=
license-allowed=AGPL-3,GPL-2,GPL-3,LGPL-3,OEEL-1,OPL-1,Other proprietary
valid-odoo-versions=16.0

[MESSAGES CONTROL]
disable=all
enable=manifest-required-author,
    manifest-required-key,
    manifest-required-key-app,
    manifest-version-format,
    manifest-author-string,
    manifest-maintainers-list,
    license-allowed,
    invalid-commit,
    sql-injection,
    external-request-timeout,
    test-folder-imported,
    no-write-in-compute,
    no-raise-unlink,
    deprecated-name-get,
    deprecated-inselect-operator,
    method-compute,
    method-search,
    method-inverse,
    method-required-super,
    prohibited-method-override,
    translation-required,
    translation-unsupported-format,
    translation-format-truncated,
    translation-too-many-args,
    translation-too-few-args,
    resource-not-exist,
    odoo-exception-warning,
    print-used,
    except-pass,
    odoo-addons-relative-import,
    website-manifest-key-not-valid-uri,
    context-overridden,
    manifest-data-duplicated
