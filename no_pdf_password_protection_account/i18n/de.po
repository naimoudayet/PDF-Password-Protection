#. module: no_pdf_password_protection_account
#. odoo-python
#: code:addons/no_pdf_password_protection_account/models/ir_actions_report.py:0
msgid "<p>The attached document is password protected. Please open it with the password we have shared with you.</p>"
msgstr "<p>Das beigefügte Dokument ist passwortgeschützt. Bitte öffnen Sie es mit dem Passwort, das wir Ihnen mitgeteilt haben.</p>"

#. module: no_pdf_password_protection_account
