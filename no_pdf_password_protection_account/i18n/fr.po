#. module: no_pdf_password_protection_account
#. odoo-python
#: code:addons/no_pdf_password_protection_account/models/ir_actions_report.py:0
msgid "<p>The attached document is password protected. Please open it with the password we have shared with you.</p>"
msgstr "<p>Le document joint est protégé par un mot de passe. Veuillez l'ouvrir avec le mot de passe que nous vous avons communiqué.</p>"

#. module: no_pdf_password_protection_account
#: model:ir.model,name:no_pdf_password_protection_account.model_account_move_send
msgid "Account Move Send"
msgstr "Envoi d'écriture comptable"

#. module: no_pdf_password_protection_account
#: model:ir.model,name:no_pdf_password_protection_account.model_account_move_send_wizard
msgid "Account Move Send Wizard"
msgstr "Assistant d'envoi d'écriture comptable"

#. module: no_pdf_password_protection_account
#: model:ir.model.fields,help:no_pdf_password_protection_account.field_account_move_send_wizard__x_pdf_notice_in_email
msgid "Adds the notice configured on the invoice report above the message, so the customer is not left with a file that will not open. It is only added when the document really was protected."
msgstr "Ajoute au-dessus du message l'avis configuré sur le rapport de facture, afin que le client ne reçoive pas un fichier qui refuse de s'ouvrir. Il n'est ajouté que si le document a réellement été protégé."

